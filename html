<script>
// أضف قصصك هنا: title, desc, cat (يطابق اسم النوع), url (رابط المشاهدة)
const IG="https://www.instagram.com/qssblahdwd?dlrf=MWtkbjk2eXhwaDF3NQ%3D%3D&utm_source=qr";
const STORIES=[
 {title:"قصة تجريبية: الباب الأخير",desc:"نموذج لعرض قصة درامية. استبدله بقصتك الفعلية.",cat:"درامية",url:IG},
 {title:"قصة تجريبية: ليلة بلا نهاية",desc:"نموذج لقصة مشوقة مليئة بالمفاجآت.",cat:"مشوقة",url:IG},
 {title:"قصة تجريبية: صدى في الممر",desc:"نموذج لقصة رعب وغموض.",cat:"رعب وغموض",url:IG},
 {title:"قصة تجريبية: خطة فاشلة بامتياز",desc:"نموذج لقصة كوميدية خفيفة.",cat:"كوميدية",url:IG},
 {title:"قصة تجريبية: خريطة النجوم",desc:"نموذج لمغامرة خيالية.",cat:"خيالية ومغامرات",url:IG},
 {title:"قصة تجريبية: رسالة متأخرة",desc:"نموذج لقصة حب وخيانة.",cat:"حب وخيانة",url:IG}
];
const GENRES=[
 {n:"درامية",e:"🎭",d:"حكايات إنسانية تلمس القلب.",c:"#6d28d9,#2e1065"},
 {n:"مشوقة",e:"🔥",d:"أحداث متسارعة وأنفاس محبوسة.",c:"#b45309,#3b1305"},
 {n:"رعب وغموض",e:"👻",d:"ألغاز وظلال تنتظر من يكشفها.",c:"#1e293b,#0b0714"},
 {n:"كوميدية",e:"😂",d:"ضحك ومواقف لا تُنسى.",c:"#ca8a04,#5b21b6"},
 {n:"خيالية ومغامرات",e:"🌍",d:"عوالم جديدة ورحلات مدهشة.",c:"#0f766e,#312e81"},
 {n:"حب وخيانة",e:"💔",d:"مشاعر صادقة وقرارات صعبة.",c:"#be123c,#2e1065"},
 {n:"كرتونية",e:"🍉",d:"شخصيات مرحة وحكايات ملونة.",c:"#15803d,#be185d"}
];
const S=p=>`<svg viewBox="0 0 24 24" aria-hidden="true">${p}</svg>`;
const ICON={"🎭":S('<path d="M3 4h10v7a5 5 0 0 1-10 0z"/><path d="M6 8h.01M10 8h.01M6 12c1 1 3 1 4 0"/><path d="M13 8h8v6a4 4 0 0 1-8 0z"/><path d="M15.5 11h.01M18.5 11h.01M15.5 14.5c1 .8 2 .8 3 0"/>'),"🔥":S('<path d="M12 3c1 4 5 5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 0 2 1 3 2 3 0-3-1-6 1-9z"/>'),"👻":S('<path d="M5 21V11a7 7 0 0 1 14 0v10l-3-2-2 2-2-2-2 2-2-2z"/><path d="M9.5 11h.01M14.5 11h.01"/>'),"😂":S('<circle cx="12" cy="12" r="9"/><path d="M8 14c1 3.5 7 3.5 8 0z"/><path d="M8 9.5l2 .8M16 9.5l-2 .8"/>'),"🌍":S('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3.5 3 3.5 15 0 18M12 3c-3.5 3-3.5 15 0 18"/>'),"💔":S('<path d="M12 20S4 15 4 9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15 12 20 12 20z"/><path d="M12 7l-2 4 3 2-2 4"/>'),"🍉":S('<path d="M3 10a9 9 0 0 0 18 0z"/><path d="M3 10h18"/><path d="M8 14h.01M12 16h.01M16 14h.01"/>')};
let cat="الكل",term="";
const $=id=>document.getElementById(id);
const bg=c=>`background:linear-gradient(135deg,${c})`;
function mk(t,a,h){const x=document.createElement(t);Object.assign(x,a||{});if(h!=null)x.textContent=h;return x}
$("genreGrid").append(...GENRES.map(g=>{
 const b=mk("button",{className:"genre",type:"button"});b.dataset.n=g.n;b.setAttribute("aria-pressed","false");
 const p=mk("div",{className:"pic"});p.innerHTML=ICON[g.e];p.style.cssText=bg(g.c);
 const t=mk("div",{className:"tx"});t.append(mk("h3",{},"قصص "+g.n),mk("p",{},g.d));
 b.append(p,t);b.onclick=()=>{setCat(cat===g.n?"الكل":g.n);$("stories").scrollIntoView()};return b}));
function chips(){const box=$("chips");box.replaceChildren(...["الكل",...GENRES.map(g=>g.n)].map(n=>{
 const b=mk("button",{className:"chip",type:"button"},n);b.setAttribute("aria-pressed",String(n===cat));b.onclick=()=>setCat(n);return b}))}
function setCat(n){cat=n;chips();document.querySelectorAll(".genre").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.n===cat)));render()}
function render(){
 const list=STORIES.filter(s=>(cat==="الكل"||s.cat===cat)&&(s.title+s.desc+s.cat).includes(term));
 const g=$("storyGrid");
 if(!list.length){g.replaceChildren(mk("p",{className:"empty"},"لا توجد قصص مطابقة. جرّب كلمة أخرى أو اختر «الكل»."));return}
 g.replaceChildren(...list.map(s=>{
  const gi=GENRES.find(x=>x.n===s.cat)||GENRES[0];
  const c=mk("article",{className:"story"});const p=mk("div",{className:"pic"});p.innerHTML=ICON[gi.e];p.style.cssText=bg(gi.c);
  const t=mk("div",{className:"tx"});
  const a=mk("a",{className:"btn ghost",href:s.url,target:"_blank",rel:"noopener noreferrer"},"شاهد القصة");
  t.append(mk("span",{className:"tag"},s.cat),mk("h3",{},s.title),mk("p",{},s.desc),a);
  c.append(p,t);return c}));
}
$("q").addEventListener("input",e=>{term=e.target.value.trim();render()});
chips();render();
</script>
